+        {
+            const char *part = new_bundle_name + input;
+            size_t take = 1, length = 1;
+            unsigned char ch = (unsigned char)*part;
+            if (ch == '&') part = "&amp;", length = 5;
+            else if (ch == '<') part = "&lt;", length = 4;
+            else if (ch == '>') part = "&gt;", length = 4;
+            else if (ch == '"') part = "&quot;", length = 6;
+            else if (ch == '\'') part = "&apos;", length = 6;
