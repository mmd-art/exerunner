+++ b/dlls/winemac.drv/cursor_guard.h
@@ -0,0 +1,17 @@
+/* ExeRunner capture guard: screen coordinates are macOS points, never pixels. */
+#ifndef EXERUNNER_CURSOR_GUARD_H
+#define EXERUNNER_CURSOR_GUARD_H
+#include <CoreGraphics/CoreGraphics.h>
+static inline CGRect exerunner_guard_cursor_rect(CGRect request, CGRect window)
+{
+    CGRect clipped;
+    const CGFloat margin = 2.0;
+    if (CGRectIsInfinite(request) || CGRectIsNull(request) || CGRectIsEmpty(request) ||
+        CGRectIsInfinite(window) || CGRectIsNull(window) || CGRectIsEmpty(window)) return request;
+    clipped = CGRectIntersection(request, window);
+    /* Preserve recenter/one-point locks and non-intersecting requests exactly. */
+    if (CGRectIsEmpty(clipped) || clipped.size.width <= margin * 2 ||
+        clipped.size.height <= margin * 2) return request;
+    return CGRectInset(clipped, margin, margin);
+}
+#endif
