+++ b/dlls/winecoreaudio.drv/stereo_downmix.h
@@ -0,0 +1,11 @@
+/* Diagnostic opt-in 5.1 -> stereo mix. Standard Windows order:
+ * FL, FR, FC, LFE, left surround, right surround. LFE is omitted.
+ * Normalize the sum of each output's gains to 1 to retain headroom.
+ */
+static inline void exerunner_mix_51_frame(const float *in, float *out)
+{
+    const float front = 0.414213562373095f;
+    const float surround = 0.292893218813452f;
+    out[0] = in[0] * front + (in[2] + in[4]) * surround;
+    out[1] = in[1] * front + (in[2] + in[5]) * surround;
+}
